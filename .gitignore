# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyo

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Logs: ignore the contents of logs/ but keep the directory itself
logs/*
!logs/.gitkeep

results/*
!results/.gitkeep

# Local diagnostic scripts (profiling, benchmarks, golden checks)
tools/
